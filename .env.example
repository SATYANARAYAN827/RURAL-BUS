# =====================================================================
# RuralBus SaaS: Environment Configuration Template (Localhost-First)
# =====================================================================

# Server Configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
API_BASE_URL=http://localhost:4000

# PostgreSQL Database (Docker on localhost:5432)
DATABASE_URL=postgresql://ruralbus_app:app_secure_password@localhost:5432/ruralbus
DATABASE_ADMIN_URL=postgresql://postgres:postgres_secure_password@localhost:5432/ruralbus

# Redis In-Memory Store & Pub/Sub (Docker on localhost:6379)
REDIS_URL=redis://localhost:6379

# Authentication & JWT Secrets
JWT_SECRET=super_secret_jwt_signing_key_at_least_32_characters_long_for_dev
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# Payment Adapter (Razorpay / Mock Mode)
PAYMENTS_MODE=mock
RAZORPAY_KEY_ID=rzp_test_mock_key
RAZORPAY_KEY_SECRET=rzp_test_mock_secret
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_mock_secret

# Map Provider Adapter (Mapbox / Google Maps / Mock)
MAP_PROVIDER=mock
MAPBOX_ACCESS_TOKEN=pk.mock_token

# Admin Web Portal URL
ADMIN_WEB_URL=http://localhost:5173

# =====================================================================
# Production SMS Gateway Configuration (India / Global)
# Provider options: fast2sms | twilio | msg91 | mock
# =====================================================================
SMS_PROVIDER=mock

# Fast2SMS (Recommended for India - https://www.fast2sms.com)
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Twilio (Global - https://www.twilio.com)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here

# MSG91 (India Enterprise - https://msg91.com)
MSG91_AUTH_KEY=your_msg91_auth_key_here
MSG91_TEMPLATE_ID=your_msg91_template_id_here
